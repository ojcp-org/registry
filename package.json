{
  "name": "@ojcp/registry",
  "version": "0.1.0",
  "private": true,
  "description": "The OJCP provider registry — one reviewed JSON entry per provider.",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "validate": "tsx src/validate.ts",
    "validate:offline": "tsx src/validate.ts --offline",
    "build": "tsx src/build-index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ && prettier --check src/",
    "lint:fix": "eslint --fix src/ && prettier --write src/"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "chalk": "^5.6.2"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0"
  },
  "engines": {
    "node": ">=20"
  }
}
